---
interface Props {
  href: string;
  image: string;
  title: string;
  body: string;
}

const { href, image, title, body } = Astro.props;
---

<li class="link-card">
  <a href={href}>
    <div class="img">
      <img
        width="226"
        height="127"
        src={image}
        class="card-img"
        alt="ProjectImage"
      />
    </div>
    <h3 class="card-title">{title}</h3>
    <p class="card-txt">{body}</p>
  </a>
</li>

<style>
  .link-card {
    list-style: none;
  }

  .link-card > a {
    display: grid;
    gap: 2.75rem;
    height: 100%;
    padding: 1.4rem;
    border-radius: 0.75rem;
    background: var(--surface-container-lowest);
    outline: 1px solid var(--outline-ghost);
    color: var(--on-surface);
    text-decoration: none;
    transition: outline-color 400ms linear;
  }

  .link-card > a:hover,
  .link-card > a:focus {
    outline-color: rgba(113, 120, 124, 0.4);
  }

  .img {
    text-align: center;
  }

  img {
    border-radius: 0.5rem;
    max-width: 100%;
    height: auto;
  }

  h3 {
    font-family: 'Manrope', sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-align: left;
  }

  p {
    margin: 0;
    font-size: 0.95rem;
    text-indent: 0;
    text-align: left;
  }
</style>
