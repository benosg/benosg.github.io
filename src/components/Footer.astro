---
const year = new Date().getFullYear();
---

<footer>
  <div>
    <small>&copy; {year} benosg <a href="https://github.com/benosg">benosg</a>. All Rights Reserved.</small>
  </div>
</footer>

<style>
  div {
    margin: 5rem 0 1rem;
    text-align: center;
  }

  small {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  small a {
    color: var(--primary);
    text-decoration: none;
  }
</style>
