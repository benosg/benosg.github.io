---
import Layout from "../layouts/Layout.astro";
const pageTitle = "Beno | Senior Backend Architect";

const stackGroups = [
  {
    title: "Languages & Core",
    icon: "⌘",
    items: ["C#", ".NET 8", "SQL"],
  },
  {
    title: "Cloud & Infra",
    icon: "☁",
    items: ["Azure", "Docker", "CI/CD"],
  },
  {
    title: "Security",
    icon: "◈",
    items: ["OAuth2", "OWASP", "Encryption"],
  },
  {
    title: "AI & Logic",
    icon: "◎",
    items: ["OpenAI API", "Semantic Kernel"],
  },
];

const milestones = [
  {
    years: "2018 - Presente",
    title: "Cloud Architecture & AI Integration",
    body: "Liderazgo técnico en migración de sistemas legacy a entornos cloud-native en Azure, incorporando IA para optimización de operaciones backend.",
    era: "Current Era",
  },
  {
    years: "2010 - 2018",
    title: "Enterprise .NET & SQL Scaling",
    body: "Diseño de APIs robustas y plataformas de datos transaccionales para dominios de alta carga en finanzas y logística.",
    era: "Growth Era",
  },
  {
    years: "1998 - 2010",
    title: "Foundations & Legacy Mastery",
    body: "Desarrollo de sistemas críticos con Clipper, Pascal y primeras versiones de .NET, con foco en lógica de negocio compleja.",
    era: "Foundation Era",
  },
];
---

<Layout pageTitle={pageTitle}>
  <main class="landing-main">
    <section class="landing-hero" id="home">
      <div class="section-shell hero-grid">
        <div class="hero-copy">
          <span class="label">Senior Systems Architect</span>
          <h1>Beno</h1>
          <p class="hero-subtitle">
            Backend Developer | .NET | SQL Server | Azure | Arquitectura |
            Seguridad | IA
          </p>
          <p class="hero-lead">
            Más de 25 años construyendo soluciones backend sólidas, escalables y
            seguras.
          </p>
          <div class="hero-actions">
            <a href="#projects" class="btn-primary">Explorar Proyectos</a>
            <a href="/works/" class="btn-secondary">Ver Portafolio</a>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <img src="/space.webp" alt="Arquitectura backend" />
          <div class="hero-stat">25+</div>
          <div class="hero-focus">
            <p class="label">Current Focus</p>
            <p>IA Aplicada y Arquitecturas de Alta Disponibilidad</p>
          </div>
        </div>
      </div>
    </section>

    <section class="band" id="about">
      <div class="section-shell about-grid">
        <div>
          <p class="label">Sobre mí</p>
          <h2>La evolución de la precisión.</h2>
        </div>
        <div class="body-grid">
          <p>
            Mi viaje en desarrollo comenzó con fundamentos rigurosos en Clipper y
            Pascal. Esa disciplina formó mi enfoque: el código no solo debe
            funcionar, también debe ser eficiente por diseño.
          </p>
          <p>
            Hoy esa base se expresa en arquitecturas modernas sobre .NET, Azure e
            inteligencia artificial, priorizando seguridad, observabilidad y
            escalabilidad como pilares no negociables.
          </p>
        </div>
      </div>
    </section>

    <section class="landing-section" id="experience">
      <div class="section-shell">
        <p class="label">Trayectoria</p>
        <div class="timeline">
          {milestones.map((item) => (
            <article class="milestone">
              <p class="milestone-years">{item.years}</p>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
              <span class="era-chip">{item.era}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="band" id="stack">
      <div class="section-shell">
        <p class="label">Ecosistema tecnológico</p>
        <h2>Herramientas seleccionadas para máxima fiabilidad.</h2>
        <div class="stack-grid">
          {stackGroups.map((group) => (
            <article class="stack-card">
              <span class="stack-icon">{group.icon}</span>
              <h3>{group.title}</h3>
              <ul class="tech-chips" role="list">
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="landing-section" id="projects">
      <div class="section-shell">
        <p class="label">Proyectos</p>
        <h2>Arquitectura en acción</h2>
        <div class="projects-grid">
          <article class="project">
            <img src="/pc.png" alt="Enterprise API Gateway" />
            <h3>Enterprise API Gateway</h3>
            <p>
              Plataforma de alta disponibilidad para más de 1M de peticiones
              diarias con seguridad integrada.
            </p>
          </article>
          <article class="project">
            <img src="/blog.webp" alt="AI Logistics Engine" />
            <h3>AI Logistics Engine</h3>
            <p>
              Motor de optimización de rutas con algoritmos de decisión e
              integración de LLMs para reportes operacionales.
            </p>
          </article>
          <article class="project">
            <img src="/laptop.webp" alt="Secure Core Banking" />
            <h3>Secure Core Banking</h3>
            <p>
              Modernización de base crítica SQL Server con cifrado a nivel de
              celda y auditoría reforzada.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="teaching" id="teaching">
      <div class="section-shell teaching-grid">
        <div>
          <p class="label">Docencia y mentoría</p>
          <h2>Desarrollo seguro de software.</h2>
          <p>
            Comparto experiencia formando arquitectos backend con foco en
            seguridad desde el diseño y escritura de código defensivo.
          </p>
        </div>
        <div class="teaching-box">
          <p class="teaching-number">500+</p>
          <p class="label">Alumnos formados</p>
        </div>
      </div>
    </section>

    <section class="landing-section" id="interests">
      <div class="section-shell">
        <p class="label">Áreas de interés</p>
        <div class="interests-grid">
          <article>
            <h3>IA Aplicada</h3>
            <p>
              Explorando cómo los LLMs optimizan procesos backend y aceleran
              decisiones técnicas.
            </p>
          </article>
          <article>
            <h3>Arquitectura Backend</h3>
            <p>
              Diseñando resiliencia, observabilidad y eficiencia en sistemas
              distribuidos de gran escala.
            </p>
          </article>
          <article>
            <h3>Aprendizaje Continuo</h3>
            <p>
              Manteniéndome actualizado sin perder la disciplina de los
              fundamentos computacionales.
            </p>
          </article>
        </div>
      </div>
    </section>
  </main>
</Layout>
