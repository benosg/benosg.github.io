---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
const pageTitle = "Publicaciones";
---

<Layout pageTitle={pageTitle}>
  <main>
    <section class="hero">
      <div class="gif">
        <img width="300" height="259" alt="blog" src="/blogTop.png" />
      </div>
      <h1>Notas Técnicas</h1>
      <span class="kicker">Artículos y charlas</span>
    </section>

    <section>
      <h2>Blog</h2>
      <ul role="list" class="link-card-grid">
        <Card
          href="https://medium.com/"
          image="/blog.png"
          title="Blog 1"
          body="Descripción breve del proyecto, enfoque técnico y resultados obtenidos en producción"
        />
        <Card
          href="https://medium.com/"
          image="/blog.png"
          title="Blog 2"
          body="Descripción breve del proyecto, enfoque técnico y resultados obtenidos en producción"
        />
        <Card
          href="https://medium.com/"
          image="/blog.png"
          title="Blog 3"
          body="Descripción breve del proyecto, enfoque técnico y resultados obtenidos en producción"
        />
        <Card
          href="https://medium.com/"
          image="/blog.png"
          title="Blog 4"
          body="Descripción breve del proyecto, enfoque técnico y resultados obtenidos en producción"
        />
      </ul>
    </section>

    <section>
      <h2>YouTube</h2>
      <ul role="list" class="link-card-grid">
        <Card
          href="https://www.youtube.com/"
          image="/youtube.png"
          title="Vídeo 1"
          body="Descripción breve del proyecto, enfoque técnico y resultados obtenidos en producción"
        />
        <Card
          href="https://www.youtube.com/"
          image="/youtube.png"
          title="Vídeo 2"
          body="Descripción breve del proyecto, enfoque técnico y resultados obtenidos en producción"
        />
      </ul>
    </section>
  </main>
</Layout>
